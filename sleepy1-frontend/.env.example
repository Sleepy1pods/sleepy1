# Sleepy1 Frontend — Environment Variables
# Copy this file to `.env.local` for local development.
# None of these are required yet — the app currently runs entirely on static mock data
# and mock services (see src/services/). They exist so a future backend can be wired in
# without restructuring the project.

# Base URL of the future Sleepy1 backend API (unused until services are switched to fetch())
VITE_API_BASE_URL=http://localhost:8080/api

# Toggles mock service layer vs real HTTP calls once the backend exists
VITE_USE_MOCK_DATA=true

# Public map tile provider (OpenStreetMap by default, no key required)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Placeholder for a future payment gateway public key (Razorpay/Stripe etc.)
VITE_PAYMENT_PUBLIC_KEY=
